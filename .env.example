# Optional for local use. Copy to .env. Do not commit .env or the database.
NODE_ENV=development
HOST=127.0.0.1
PORT=3040
APP_ORIGIN=http://127.0.0.1:3040
DATABASE_PATH=data/clinique.sqlite

# Production: NODE_ENV=production, APP_ORIGIN=https://your-host.example
# Use a persistent DATABASE_PATH and an HTTPS reverse proxy.
# Never put administrator passwords, cookies or session tokens here.

# Optional repair-status e-mails (Resend, with a verified sending domain).
# Store RESEND_API_KEY only in .env locally, or as a Cloudflare Worker secret.
# Never put it in VITE_* variables, source files, or a JSON workshop export.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_PORTAL_ORIGIN=http://127.0.0.1:3040
