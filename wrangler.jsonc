// Reparapid : créer une base D1 dédiée et remplacer database_id avant publication.
// Aucun compte, contact ou identifiant de base du projet d’origine n’est utilisé.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reparapid",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reparapid",
      "migrations_dir": "cloudflare/migrations",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": false
  }
}
